# Ghostty config — mirrors alacritty/alacritty.toml
# Gruvbox Dark Hard, keratoconus-tuned. Install to ~/.config/ghostty/config

# Font — Bold is the default weight; heavier strokes reduce ghosting/double vision.
font-family = D2CodingLigature Nerd Font
font-size = 18
font-style = Bold
font-style-bold = Bold

# Extra letter (width) and line (height) spacing to fight ghosting/overlap.
# Equivalent of alacritty's font.offset x = 1, y = 4.
adjust-cell-width = 1px
adjust-cell-height = 4px
# Optional extra thickening if Bold alone is not enough: font-thicken = true

# Launch straight into tmux (attach existing session or start one).
command = /bin/zsh -l -c "tmux attach || tmux"

# Initial window size, in grid cells.
window-width = 180
window-height = 60

# macOS: send Option as Meta so Claude Code's Option shortcuts work.
macos-option-as-alt = true

# Gruvbox Dark Hard — high contrast without harsh pure-white-on-pure-black.
background = #1d2021
foreground = #ebdbb2
cursor-color = #fabd2f
cursor-text = #1d2021
selection-background = #fabd2f
selection-foreground = #1d2021
bold-is-bright = true

# Normal colors (palette 0-7)
palette = 0=#1d2021
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984

# Bright colors (palette 8-15)
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2

# Shift+Enter -> newline for Claude Code. Ghostty handles this natively, so it is
# left commented; uncomment to force the exact sequence alacritty sends.
# keybind = shift+enter=text:\x1b\r
